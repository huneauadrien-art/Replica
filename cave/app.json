{
  "expo": {
    "name": "Ma Cave",
    "slug": "ma-cave",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "fr.huneau.macave"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#3a1e25",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "fr.huneau.macave"
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "output": "single"
    },
    "plugins": [
      "expo-router",
      "expo-sharing",
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Pour joindre la photo de l’étiquette d’une bouteille.",
          "cameraPermission": "Pour photographier l’étiquette d’une bouteille.",
          "microphonePermission": false
        }
      ]
    ],
    "scheme": "macave",
    "backgroundColor": "#1e1518"
  }
}
